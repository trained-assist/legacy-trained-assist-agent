[Unit]
Description=Trained Assist Agent — Claude Code session runner
After=network-online.target
Wants=network-online.target
OnFailure=assist-agent-notify-failure.service

[Service]
Type=simple
User=vova
WorkingDirectory=/home/vova/agent-master
# Kill any process still holding port 8080 before we try to bind.
# Uses lsof (more reliable than fuser across distros); sleep 1 gives the
# kernel time to release the socket before the new server calls listen().
ExecStartPre=/bin/bash -c 'pids=$(lsof -ti tcp:8080 2>/dev/null); [ -n "$pids" ] && { echo "[pre-start] killing PIDs on :8080: $pids"; kill -9 $pids 2>/dev/null; sleep 1; }; true'
ExecStart=/usr/bin/node src/server.js
# mixed: SIGTERM goes to node only, so it can flag the restart and journal running tasks
# before anything else dies; once node exits, systemd SIGKILLs the leftover Claude children.
KillMode=mixed
Restart=always
# Wait 15s between restarts — enough for TCP sockets to clear and prevents
# a rapid-fire death spiral (we hit restart count 3331 on 2026-08-29).
RestartSec=2
# Stop retrying after 10 failures in 5 minutes — surface the problem
# instead of looping silently. Operator must restart manually after this.
StartLimitIntervalSec=300
StartLimitBurst=10
# Shutdown is instant (no drain) — this is only a backstop before SIGKILL.
TimeoutStopSec=15
EnvironmentFile=-/home/vova/secrets.env
Environment=NODE_ENV=production
# Agent engines (claude/opencode/codex) inherit this PATH. ~/.local/bin holds `gh`,
# which the engineering playbooks rely on (issue/PR/CI steps); without it every
# GitHub step of a durable plan fails with "gh: command not found".
Environment=PATH=/home/vova/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
Environment=MEDIA_GATEWAY_URL=https://trained-assist-tg-bot.skillset-apply.workers.dev
Environment=PORT=8080
Environment=AGENT_DATA_DIR=/home/vova/agent-data
# Canonical storage roots — set explicitly so a restart/HOME change can never
# silently relocate them (identity ≠ location). See src/data-paths.js.
Environment=USERS_DIR=/home/vova/users
Environment=AGENT_TOKENS_DIR=/home/vova/agent-tokens
# ── Per-host identity: NOT here ──────────────────────────────────────────────
# VM_NAME, AGENT_PUBLIC_URL, HH_PLATFORM_URL, CRON_SCHEDULER_ROLE and
# MAX_CONCURRENT_TASKS describe ONE machine, not the fleet, so they live in
# /etc/systemd/system/assist-agent.service.d/20-host-identity.conf — one file
# per host under infra/systemd/host/, installed by
# scripts/ops/install-host-config.sh <vm-name> (issue #2114 P0.2/P0.3).
#
# Why they left the shared unit: with them here, a second box inherited gcp-main
# as its identity and GCP's public URLs, so links generated on VM2 led to the
# GCP host being shut down, and CRON_SCHEDULER_ROLE=primary was true of every
# box that had no drop-in yet — two cron primaries run every job twice. A unit
# that only holds fleet-wide values cannot answer that twice.
#
# Fleet-wide values that stay (same on every host): AGENT_PAGES_URL, the RU-edge
# URLs, GCP_PROJECT, ANTHROPIC_MODEL, GCS_BUCKET, PORT, NODE_ENV, PATH.
# Pages origin — the branded domain of the area, for links a human opens
# (instant-publish /p/*, every HH page). Page links naming a legacy origin are
# repointed here on the way out (src/public-links.js); /health reports which
# origin is in effect and whether this var was ignored.
Environment=AGENT_PAGES_URL=https://recruiter-assistant.ru
Environment=VACANCY_REMOTE_STORE_URL=https://platform.recruiter-assistant.ru
# RU-IP edge service (src/ru-edge.js, issue #1288) — nalog.ru login delegation
# and the lknpd.nalog.ru API relay both go here; same host as
# VACANCY_REMOTE_STORE_URL above (one RU box, several purposes).
Environment=RU_EDGE_URL=https://platform.recruiter-assistant.ru
Environment=GCP_PROJECT=alesa-personal-assistent
Environment=ANTHROPIC_MODEL=claude-opus-5-5
# Session archive bucket (src/session-blob-store.js, epic #1784 M2 / issue #1916).
# Matches the module's own default, so this line documents rather than configures.
Environment=GCS_BUCKET=trained-assist-workspaces

[Install]
WantedBy=multi-user.target
