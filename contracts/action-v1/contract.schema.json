{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:trained-assist:action-contract:v1",
  "title": "Action/provider/cron v1 contracts; runtime wiring deferred",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?!.*\\.\\.)[\\p{L}\\p{N}][\\p{L}\\p{N}_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "arguments": {
      "type": "object"
    },
    "trigger": {
      "enum": [
        "user",
        "cron",
        "durable_task",
        "webhook",
        "system"
      ]
    },
    "origin": {
      "description": "Where the call entered core. Distinguishes web/mcp/telegram without adding a trigger (spec §7). Core sets it from trusted call context, never from provider arguments.",
      "enum": [
        "web",
        "mcp",
        "telegram",
        "api",
        "cron-service",
        "durable"
      ]
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 120
        },
        "arguments": {
          "$ref": "#/$defs/arguments"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "profileId",
        "projectId",
        "action",
        "arguments",
        "trigger",
        "idempotencyKey"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENTS",
            "ACTION_NOT_FOUND",
            "FORBIDDEN",
            "APPROVAL_REQUIRED",
            "PROVIDER_UNAVAILABLE",
            "TIMEOUT",
            "CONFLICT",
            "ACTION_FAILED",
            "OUTCOME_UNKNOWN"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "executionId": {
              "$ref": "#/$defs/id"
            },
            "status": {
              "const": "succeeded"
            },
            "output": {}
          },
          "required": [
            "version",
            "executionId",
            "status",
            "output"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "executionId": {
              "$ref": "#/$defs/id"
            },
            "status": {
              "enum": [
                "failed",
                "rejected",
                "unknown"
              ]
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "required": [
            "version",
            "executionId",
            "status",
            "error"
          ]
        }
      ]
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 120
        },
        "inputSchema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        },
        "allowedTriggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "effect": {
          "enum": [
            "read",
            "write",
            "external_message",
            "destructive"
          ]
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "retrySafety": {
          "enum": [
            "read_only",
            "idempotent",
            "unsafe"
          ]
        },
        "schedule": {
          "$ref": "#/$defs/actionSchedule"
        }
      },
      "required": [
        "name",
        "inputSchema",
        "allowedTriggers",
        "effect",
        "requiresApproval",
        "retrySafety"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "providerId": {
          "$ref": "#/$defs/id"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descriptor"
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "providerId",
        "actions"
      ]
    },
    "contextField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "json"
          ]
        },
        "source": {
          "enum": [
            "context_store",
            "capability",
            "cron"
          ]
        },
        "default": {}
      },
      "required": [
        "key",
        "label",
        "type",
        "source"
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "name",
        "schemaVersion"
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requiredFor": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "requiredFor"
      ]
    },
    "webSurface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "access": {
          "enum": [
            "private_profile"
          ]
        },
        "queryAction": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 120
        }
      },
      "required": [
        "id",
        "title",
        "access",
        "queryAction"
      ]
    },
    "providerV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2
        },
        "providerId": {
          "$ref": "#/$defs/id"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descriptor"
          },
          "minItems": 1
        },
        "contextFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextField"
          },
          "minItems": 1
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "webSurfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/webSurface"
          }
        }
      },
      "required": [
        "version",
        "providerId",
        "actions",
        "contextFields"
      ]
    },
    "cron_create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "schedule": {
          "type": "string",
          "pattern": "^\\S+( \\S+){4}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 120
        },
        "arguments": {
          "$ref": "#/$defs/arguments"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "schedule",
        "timezone",
        "action",
        "arguments"
      ]
    },
    "cron_list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "cron_get": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id"
      ]
    },
    "cron_delete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id"
      ]
    },
    "cron_run_now": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "idempotencyKey"
      ]
    },
    "cron_update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "schedule": {
              "type": "string",
              "pattern": "^\\S+( \\S+){4}$"
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 120
            },
            "arguments": {
              "$ref": "#/$defs/arguments"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": [
        "id",
        "patch"
      ]
    },
    "actionSchedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCron": {
          "type": "string",
          "maxLength": 100
        },
        "minIntervalMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "settingsSchema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        },
        "delivery": {
          "enum": [
            "silent",
            "on_change",
            "on_error",
            "always"
          ]
        },
        "costClass": {
          "enum": [
            "free",
            "cheap_llm",
            "llm",
            "paid_api"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "minIntervalMinutes",
        "delivery",
        "costClass",
        "label"
      ]
    }
  }
}
