{
  "version": 1,
  "credentials": [
    {
      "consumer": "speech-skill:deepgram",
      "scope": "profile",
      "host": "bridge",
      "env": ["SYSTEM_DEEPGRAM_API_KEY"],
      "aliases": ["DEEPGRAM_API_KEY", "DEEPGRAM_KEY"],
      "files": ["deepgram/key.txt"],
      "filesRoot": "tokens",
      "source": "user-tokens + secrets-env (canonical SYSTEM_DEEPGRAM_API_KEY)",
      "reader": "trained-assist-speech-skill src/deepgram/key-store.js resolveKey",
      "note": "#2046: canonical SYSTEM_DEEPGRAM_API_KEY. Order: DEEPGRAM_KEY env → key.txt → SYSTEM_DEEPGRAM_API_KEY env → legacy DEEPGRAM_API_KEY alias"
    },
    {
      "consumer": "core:cloudflare",
      "scope": "platform",
      "host": "bridge",
      "env": ["ADMIN_CLOUDFLARE_API_TOKEN"],
      "aliases": ["CF_API_TOKEN", "CLOUDFLARE_API_TOKEN"],
      "source": "gcp-secret-manager (canonical ADMIN_CLOUDFLARE_API_TOKEN) + legacy CF_API_TOKEN alias",
      "reader": "src/cf-pages.js resolveCredential; engine wrangler",
      "note": "#2046: canonical is ADMIN_CLOUDFLARE_API_TOKEN. CF_API_TOKEN stays a loadable alias so an unmigrated Secret Manager keeps deploying. cf-pages.js resolves canonical-first, legacy-second."
    },
    {
      "consumer": "core:cloudflare-user",
      "scope": "profile",
      "files": ["cloudflare"],
      "filesRoot": "tokens",
      "source": "user-tokens (AES-256-GCM at rest, epic #1789)",
      "reader": "src/cf-pages.js readOwnToken",
      "note": "per-profile Cloudflare token {value, account_id?}. Wins over the shared admin token; falls back to it when absent. Never exported into the engine env (server-side only)."
    },
    {
      "consumer": "core:github",
      "scope": "platform",
      "host": "secrets",
      "env": ["ADMIN_GITHUB_API_TOKEN"],
      "aliases": ["GITHUB_ISSUES_TOKEN"],
      "source": "gcp-secret-manager (canonical ADMIN_GITHUB_API_TOKEN) + legacy GITHUB_ISSUES_TOKEN alias",
      "reader": "src/secrets.js loadSecrets → ADMIN_GITHUB_API_TOKEN",
      "note": "#2046: canonical is ADMIN_GITHUB_API_TOKEN. GITHUB_ISSUES_TOKEN remains a loadable alias."
    },
    {
      "consumer": "sales-skill:dadata",
      "scope": "profile",
      "host": "mcp",
      "env": ["INN_DADATA_TOKEN"],
      "aliases": ["DADATA_TOKEN"],
      "files": [".inn-config.json"],
      "filesRoot": "profile",
      "source": "secrets-env + profile file",
      "reader": "trained-assist-sales-skill src/tools/71-dadata.js",
      "note": "regression: .inn-config.json must stay reachable without env. Known divergence: 70-inn-enrichment reads agent-tokens/<u>/inn/config.json first (user wins), 71/72 read env first"
    },
    {
      "consumer": "sales-skill:checko",
      "scope": "profile",
      "host": "mcp",
      "env": ["INN_CHECKO_KEY"],
      "aliases": ["CHECKO_KEY"],
      "files": [".inn-config.json"],
      "filesRoot": "profile",
      "source": "secrets-env + profile file",
      "reader": "trained-assist-sales-skill src/tools/72-checko.js"
    },
    {
      "consumer": "hh-skill:oauth-client-id",
      "scope": "platform",
      "host": "mcp",
      "env": ["SYSTEM_HEADHUNTER_CLIENT_ID"],
      "aliases": ["HH_CLIENT_ID"],
      "source": "gcp-secret-manager (canonical SYSTEM_HEADHUNTER_CLIENT_ID) + legacy HH_CLIENT_ID alias",
      "reader": "trained-assist-hh-skill src/tools/91c-hh-sync.js",
      "note": "#2046: canonical SYSTEM_HEADHUNTER_CLIENT_ID. HH_CLIENT_ID remains a loadable alias."
    },
    {
      "consumer": "hh-skill:oauth-client-secret",
      "scope": "platform",
      "host": "mcp",
      "env": ["SYSTEM_HEADHUNTER_CLIENT_SECRET"],
      "aliases": ["HH_CLIENT_SECRET"],
      "source": "gcp-secret-manager (canonical SYSTEM_HEADHUNTER_CLIENT_SECRET) + legacy HH_CLIENT_SECRET alias",
      "reader": "trained-assist-hh-skill src/tools/91c-hh-sync.js",
      "note": "#2046: canonical SYSTEM_HEADHUNTER_CLIENT_SECRET. HH_CLIENT_SECRET remains a loadable alias."
    },
    {
      "consumer": "skills:tokens-root",
      "scope": "platform",
      "host": "mcp",
      "env": ["AGENT_TOKENS_DIR"],
      "source": "systemd env",
      "reader": "data-paths.tokensRoot (core and every sibling copy)",
      "note": "a path, not a secret: without it a sibling falls back to $HOME/agent-tokens"
    },
    {
      "consumer": "search-skill:serper",
      "scope": "platform",
      "host": "mcp",
      "env": ["SERPER_API_KEY"],
      "source": "secrets-env",
      "reader": "trained-assist-search-skill src/tools/99-search-serper.js"
    },
    {
      "consumer": "core:google-oauth",
      "scope": "platform",
      "host": "mcp",
      "env": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET"],
      "source": "secrets-env",
      "reader": "core connect flow (MCP tools)"
    },
    {
      "consumer": "core:bot-tokens",
      "scope": "platform",
      "host": "secrets",
      "env": ["TELEGRAM_BOT_TOKEN", "RECRUITER_BOT_TOKEN", "FREELANCE_BOT_TOKEN", "SALES_BOT_TOKEN"],
      "source": "gcp-secret-manager + host env (secrets.env), loaded into memory by src/secrets.js",
      "reader": "src/secrets.js loadSecretValues → src/bot-registry tokenSecretName / MISSING_BOTS",
      "note": "regression 2026-10-01: SALES_BOT_TOKEN was absent here, so the one-way contract (declared ⊆ provided) could not see an enabled bot whose token the host never loads. Every token_secret_name of an enabled bots.registry entry must be declared here AND in src/secrets.js REQUIRED/OPTIONAL — that chain is checked in both directions. Values never reach env: only the loader in src/secrets.js fetches them."
    }
  ]
}
