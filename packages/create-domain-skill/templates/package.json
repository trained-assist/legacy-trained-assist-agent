{
  "name": "@trained-assist/{{domain}}-skill",
  "version": "0.1.0",
  "private": true,
  "description": "{{domainName}} domain skill — MCP server (trained-assist Agent Control Plane)",
  "main": "src/mcp-skills/index.js",
  "scripts": {
    "check": "node --check src/mcp-skills/index.js src/mcp-skills/registry.js src/mcp-skills/tool-result.js src/mcp-skills/tools/01-example.js",
    "test:contract": "node --test test/contract.test.mjs",
    "test:behavior": "node --test test/behavior.test.mjs",
    "test": "npm run test:contract && npm run test:behavior",
    "test:staging": "node staging/run.mjs",
    "conformance": "mcp-skill-conformance .",
    "manifest:sync": "node scripts/sync-manifest.mjs"
  },
  "devDependencies": {
    "@trained-assist/mcp-skill-testkit": "^0.1.0",
    "ajv": "^8.20.0",
    "nock": "^14.0.17"
  }
}
